# Generic
DATA_DIR=/data
PORT=3000
TZ=Europe/Amsterdam

# Passkeys are bound to the exact hostname and require HTTPS (terminated at Traefik)
ORIGIN=https://opengym.k8s.javydekoning.com
RP_ID=opengym.k8s.javydekoning.com
RP_NAME=openGym

# Admin & signup — first profile on an empty instance becomes admin.
# Register yours first, then consider INVITE_ONLY=1. OIDC not supported yet (upstream roadmap).
FIRST_USER_ADMIN=1

# TRUST_PROXY left off on purpose: behind Traefik the web container only sees the
# ingress pod's address, see upstream docs/SELF_HOSTING_KUBERNETES.md
