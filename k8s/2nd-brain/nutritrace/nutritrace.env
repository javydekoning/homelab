# Generic
TZ=Europe/Amsterdam
DB_PATH=/data/db/nutritrace.db
UPLOADS_PATH=/data/uploads

# AI integration — LiteLLM proxy, OpenAI-compatible endpoint
AI_PROVIDER=oai-compat
AI_MODEL=nutritrace-default
AI_BASE_URL=http://litellm.litellm.svc.cluster.local:4000
AI_ENABLED=true

# MCP
MCP_ENABLED=1
MCP_WRITE_ENABLED=1
MCP_DESTROY_ENABLED=1
