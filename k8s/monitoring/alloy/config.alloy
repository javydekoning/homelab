loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// discovery.kubernetes allows you to find scrape targets from Kubernetes resources.
// It watches cluster state and ensures targets are continually synced with what is currently running in your cluster.
discovery.kubernetes "pod" {
  role = "pod"
}

// discovery.relabel rewrites the label set of the input targets by applying one or more relabeling rules.
// If no rules are defined, then the input targets are exported as-is.
discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pod.targets

  // Label creation - "namespace" field from "__meta_kubernetes_namespace"
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action = "replace"
    target_label = "namespace"
  }

  // Label creation - "pod" field from "__meta_kubernetes_pod_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    action = "replace"
    target_label = "pod"
  }

  // Label creation - "container" field from "__meta_kubernetes_pod_container_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "container"
  }

  // Label creation -  "app" field from "__meta_kubernetes_pod_label_app_kubernetes_io_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    action = "replace"
    target_label = "app"
  }

  // Label creation -  "job" field from "__meta_kubernetes_namespace" and "__meta_kubernetes_pod_container_name"
  // Concatenate values __meta_kubernetes_namespace/__meta_kubernetes_pod_container_name
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "job"
    separator = "/"
    replacement = "$1"
  }

  // Label creation - "container" field from "__meta_kubernetes_pod_uid" and "__meta_kubernetes_pod_container_name"
  // Concatenate values __meta_kubernetes_pod_uid/__meta_kubernetes_pod_container_name.log
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "__path__"
    separator = "/"
    replacement = "/var/log/pods/*$1/*.log"
  }

  // Label creation -  "container_runtime" field from "__meta_kubernetes_pod_container_id"
  rule {
    source_labels = ["__meta_kubernetes_pod_container_id"]
    action = "replace"
    target_label = "container_runtime"
    regex = "^(\\S+):\\/\\/.+$"
    replacement = "$1"
  }
}

// loki.source.kubernetes tails logs from Kubernetes containers using the Kubernetes API.
loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

// loki.process receives log entries from other Loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "pod_logs" {
  stage.static_labels {
      values = {
        cluster = "default",
      }
  }

  // Common noise across every app: kubelet's own health/readiness probes hit each
  // pod's HTTP endpoint constantly and show up in access logs with a distinctive
  // User-Agent. Drop these cluster-wide before any per-app parsing runs, rather
  // than repeating this in every app-specific stage.match block.
  stage.match {
    selector = `{cluster="default"} |~ "kube-probe"`

    stage.drop {
      expression = "kube-probe"
    }
  }

  // klog-formatted apps (standard Go klog prefix), e.g.
  // 'I0827 11:28:43.094395 1 nfd-worker.go:785] "feature discovery completed"'
  // First letter is the level: I/W/E/F (info/warn/error/fatal). One shared rule
  // covering every namespace using this format - add more via the alternation
  // below rather than duplicating the block.
  stage.match {
    selector = `{namespace=~"node-feature-discovery|intel-device-plugins|mount-s3"}`

    stage.regex {
      expression = `^(?P<level>[IWEF])\d{4}`
    }

    stage.template {
      source = "level"
      template = `{{ if eq .level "I" }}info{{ else if eq .level "W" }}warn{{ else if eq .level "E" }}error{{ else if eq .level "F" }}critical{{ else }}info{{ end }}`
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  // loki-canary: self-check probe pod (DaemonSet from the Loki chart, not ours).
  // It just logs its own query-loop status to stdout with no level word, and
  // has no diagnostic value in Loki itself - drop entirely rather than parse.
  stage.match {
    selector = "{namespace=\"monitoring\", container=\"canary\"}"

    stage.drop {}
  }

  // changedetection.io app container: werkzeug/Flask access log format:
  // '10.42.0.1 - - [27/Aug/2026 11:07:37] "GET / HTTP/1.1" 200 -'
  // No level word at all, so Loki's detected_level misses it entirely.
  // Also drop noisy successful polling requests (HTTP 200) to cut volume;
  // anything left (4xx/5xx) is worth keeping and gets tagged as a warning.
  stage.match {
    selector = "{namespace=\"change-detection\", container=\"changedetection\"}"

    stage.regex {
      expression = `^(?P<ip>\S+) \S+ \S+ \[(?P<ts>[^\]]+)\] "(?P<method>\S+) (?P<path>\S+) [^"]+" (?P<status>\d+) `
    }

    stage.drop {
      source     = "status"
      expression = "^200$"
    }

    stage.static_labels {
      values = {
        level = "warn",
      }
    }

    stage.timestamp {
      source = "ts"
      format = "02/Jan/2006 15:04:05"
    }
  }

  // changedetection.io selenium container: 'HH:MM:SS.mmm LEVEL [Class] - message'
  stage.match {
    selector = "{namespace=\"change-detection\", container=\"selenium\"}"

    stage.regex {
      expression = `^\d{2}:\d{2}:\d{2}\.\d{3} (?P<level>INFO|WARN|ERROR|DEBUG) `
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  // changedetection.io playwright-chrome (browserless) container: debug-namespace
  // style logs with no level word, e.g. 'TIMESTAMP browserless:server message'.
  // Everything this container logs is operational/debug-level noise.
  stage.match {
    selector = "{namespace=\"change-detection\", container=\"playwright-chrome\"}"

    stage.static_labels {
      values = {
        level = "debug",
      }
    }
  }

  // frigate: two log formats in one container.
  // 1) nginx-style access log, incl. noisy empty-request 400s from health probes.
  // 2) frigate's own '[2026-08-27 09:19:51] frigate.video ERROR : message' format.
  stage.match {
    selector = "{namespace=\"smarthome\", container=\"frigate\"}"

    // Access log line: '<ip> - - [ts] "<method> <path> HTTP/1.1" <status> ...'
    stage.match {
      selector = `{namespace="smarthome", container="frigate"} |~ "^\\S+ - - \\["`

      stage.regex {
        expression = `^\S+ - - \[[^\]]+\] "(?P<method>[^"]*)" (?P<status>\d+) `
      }

      // Drop empty-request health-probe noise (method is blank, status 400)
      stage.drop {
        source     = "method"
        expression = "^$"
      }

      stage.static_labels {
        values = {
          level = "info",
        }
      }
    }

    // Frigate's own logger line: '[2026-08-27 09:19:51] frigate.video ERROR : message'
    stage.match {
      selector = `{namespace="smarthome", container="frigate"} |~ "^\\[\\d{4}-"`

      stage.regex {
        expression = `^\[[^\]]+\]\s+\S+\s+(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)\s*:`
      }

      stage.labels {
        values = {
          level = "",
        }
      }
    }
  }

  // freshrss: Apache httpd + mod_auth_openidc.
  // 1) Apache error-log style: '[Thu Aug 27 11:45:52.407872 2026] [auth_openidc:warn] [pid ...] message'
  // 2) Apache access log: '<ip> - - [ts] "<method> <path> HTTP/1.1" <status> ... "kube-probe/1.36"'
  //    (drop kube-probe health-check noise, it's not useful signal)
  stage.match {
    selector = "{namespace=\"freshrss\", container=\"freshrss\"}"

    stage.match {
      selector = `{namespace="freshrss", container="freshrss"} |~ "^\\[\\w+ \\w+"`

      stage.regex {
        expression = `^\[\w+ \w+ \d+ [\d:.]+ \d+\] \[[^:]+:(?P<level>debug|info|notice|warn|error|crit|alert|emerg)\]`
      }

      stage.labels {
        values = {
          level = "",
        }
      }
    }

    stage.match {
      selector = `{namespace="freshrss", container="freshrss"} |~ "^\\S+ - - \\["`

      stage.regex {
        expression = `^\S+ - - \[[^\]]+\] "[^"]*" (?P<status>\d+) \d+ "[^"]*" "(?P<agent>[^"]*)"`
      }

      stage.static_labels {
        values = {
          level = "info",
        }
      }
    }
  }

  // netronome: Go/zerolog console format, e.g.
  // '2026-08-27T10:17:59Z INFO ../src/internal/scheduler/scheduler.go:458 > message ...'
  // No native JSON option in netronome's config.toml [logging] section (only `level`).
  stage.match {
    selector = "{namespace=\"monitoring\", app=\"netronome\"}"

    stage.regex {
      expression = `^\S+ (?P<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL|PANIC) `
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  // seerr: winston/overseerr-style bracketed levels, e.g.
  // '2026-08-27T10:15:04.684Z [debug][Jellyfin Sync]: message'
  // No native JSON toggle found (only LOG_LEVEL env var).
  stage.match {
    selector = "{namespace=\"dvr\", container=\"seerr\"}"

    stage.regex {
      expression = `^\S+ \[(?P<level>debug|info|warn|error)\]`
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  // librechat mongodb: already emits JSON, but severity is a single-letter code
  // in the "s" field (D/I/W/E/F), which Loki's detected_level doesn't recognize
  // as a level word. Map it to the full name it expects.
  stage.match {
    selector = "{namespace=\"librechat\", container=\"mongodb\"}"

    stage.json {
      expressions = {
        sev = "s",
      }
    }

    stage.template {
      source = "level"
      template = `{{ if eq .sev "D" }}debug{{ else if eq .sev "I" }}info{{ else if eq .sev "W" }}warn{{ else if eq .sev "E" }}error{{ else if eq .sev "F" }}critical{{ else }}info{{ end }}`
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.source.syslog "local" {
  listener {
    address  = "0.0.0.0:51893"
    labels   = { component = "loki.source.syslog", protocol = "tcp" }
  }

  forward_to = [loki.write.default.receiver]
}
